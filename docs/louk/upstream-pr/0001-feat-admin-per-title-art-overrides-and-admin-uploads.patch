+#[tokio::test]
+async fn store_load_failure_backs_off() {
+    let (_app, state) = common::setup_test_app().await;
+    use sea_orm::ConnectionTrait;
+    state
+        .db
+        .execute_unprepared("ALTER TABLE image_overrides RENAME TO image_overrides_away")
+        .await
+        .unwrap();
+    // The first load fails: no override, no error.
+    assert!(
+        store(&state)
+            .lookup(&state.db, "movie", 9_100_011, ImageType::Logo, -1, -1, "en")
+            .await
+            .is_none()
+    );
+    state
+        .db
+        .execute_unprepared("ALTER TABLE image_overrides_away RENAME TO image_overrides")
+        .await
+        .unwrap();
+    state
+        .db
+        .execute_unprepared(
+            "INSERT INTO image_overrides (media_type, tmdb_id, kind, source, value) VALUES ('movie', 9100011, 'logo', 'tmdb', '/x.png')",
+        )
+        .await
+        .unwrap();
+    // Within the retry pause the table is not queried again.
+    assert!(
+        store(&state)
+            .lookup(&state.db, "movie", 9_100_011, ImageType::Logo, -1, -1, "en")
+            .await
+            .is_none()
+    );
+    // An explicit reload (or the next retry after 30 s) sees it.
+    store(&state).reload(&state.db).await.unwrap();
+    assert!(
+        store(&state)
+            .lookup(&state.db, "movie", 9_100_011, ImageType::Logo, -1, -1, "en")
+            .await
+            .is_some()
+    );
+}
