+async fn seed_logo_file(
+    state: &AppState,
+    id_type: &str,
+    value: &str,
+    suffix: &str,
+) -> std::path::PathBuf {
+    let cache_value = format!("{value}{suffix}");
+    let path = cache::typed_cache_path(
+        &state.config.cache_dir,
+        ImageType::Logo,
+        id_type,
+        &cache_value,
+    )
+    .unwrap();
+    cache::write(&path, b"old logo").await.unwrap();
+    cache::upsert_meta_db(
+        &state.db,
+        &format!("{id_type}/{cache_value}"),
+        None,
+        ImageType::Logo,
+    )
+    .await
+    .unwrap();
+    path
+}
