+        let (status, ct, body) = get_image(&a.app, &format!("/{}/{path}", a.key)).await;
+        assert_eq!(
+            status,
+            StatusCode::OK,
+            "{path}: {}",
+            String::from_utf8_lossy(&body)
+        );
+        assert_eq!(ct, "image/png", "{path}");
+        assert_aspect(&body, 2.0);
