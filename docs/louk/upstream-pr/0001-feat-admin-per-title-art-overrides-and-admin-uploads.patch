+        );
+        let e = OverrideKey::parse("tv", "1399", "episode", Some("1"), Some("2"), None).unwrap();
+        assert_eq!((e.season, e.episode), (1, 2));
+        assert!(OverrideKey::parse("movie", "1", "episode", Some("1"), Some("2"), None).is_err());
+        assert!(OverrideKey::parse("tv", "1", "episode", Some("1"), None, None).is_err());
+        assert!(OverrideKey::parse("tv", "1", "poster", Some("1"), None, None).is_err());
+        assert!(OverrideKey::parse("movie", "1", "backdrop", None, None, Some("en")).is_err());
+        assert!(OverrideKey::parse("movie", "1", "logo", None, None, Some("english")).is_err());
+        assert!(OverrideKey::parse("movie", "0", "logo", None, None, None).is_err());
+        assert!(OverrideKey::parse("show", "1", "logo", None, None, None).is_err());
+        assert!(OverrideKey::parse("movie", "1", "thumb", None, None, None).is_err());
+        assert_eq!(
+            OverrideKey::parse("movie", "1", "poster", Some(""), Some(" "), Some(""))
+                .unwrap()
+                .lang,
+            ""
+        );
+    }
+
+    #[test]
+    fn lang_format() {
+        for ok in ["en", "pt-BR"] {
+            assert!(is_lang(ok));
+        }
+        for bad in ["", "e", "EN", "pt-br", "pt_BR", "eng"] {
+            assert!(!is_lang(bad), "{bad}");
+        }
+    }
+}
diff --git a/api/src/services/overrides/purge.rs b/api/src/services/overrides/purge.rs
new file mode 100644
index 0000000..23225ea
--- /dev/null
+++ b/api/src/services/overrides/purge.rs
@@ -0,0 +1,305 @@
+//! Purge every cached render of a title + kind when its override changes.
+//!
+//! Renders are cached per REQUESTED id (`imdb/tt…`, `tmdb/movie-…`,
+//! `tvdb/…`, plus cross-id copies) and every settings suffix, so the purge
+//! runs the admin per-title purge (`handlers::admin::purge_title`: disk
+//! files of all suffixes, `image_meta`, `available_ratings`, the
+//! `image_mem_cache` / `image_inflight` entries and `id_cache`) once per id
+//! the title is known under ([`alias_targets`]).
+
+use std::time::Duration;
+
+use axum::Json;
+use serde::Serialize;
+
+use super::{OverrideKey, apply};
+use crate::AppState;
+use crate::cache::ImageType;
+use crate::id::{self, IdType};
+
+#[derive(Serialize, Debug, Default, Clone, PartialEq, Eq)]
+pub struct PurgeOut {
+    /// Every `{id_type}/{id_value}` purged.
+    pub ids: Vec<String>,
+    pub files_deleted: u64,
+    pub meta_deleted: u64,
+    /// `"{id_type}/{id_value}: message"` for ids whose purge failed.
+    pub errors: Vec<String>,
+    /// With `EXTERNAL_CACHE_ONLY` / CDN copies: those cannot be purged here.
+    pub external_cache_only: bool,
+}
+
+/// Purge the cached renders an override of `key` affects. Never fails:
+/// errors per id are collected (and logged).
+pub async fn purge_for(state: &AppState, key: &OverrideKey) -> PurgeOut {
+    let mut out = PurgeOut {
+        external_cache_only: state.config.external_cache_only,
+        ..PurgeOut::default()
+    };
+    for (id_type, id_value) in alias_targets(state, key).await {
+        match crate::handlers::admin::purge_title(state, key.kind, &id_type, &id_value).await {
+            Ok(Json(r)) => {
+                out.files_deleted += r.files_deleted;
+                out.meta_deleted += r.meta_deleted;
+            }
+            Err(e) => {
+                tracing::warn!(error = %e, id_type = %id_type, id_value = %id_value, "override: purge failed for one id");
+                out.errors.push(format!("{id_type}/{id_value}: {e}"));
+            }
+        }
+        out.ids.push(format!("{id_type}/{id_value}"));
+    }
+    out
+}
+
+/// Re-purge this long after an override is saved or cleared: longer than
+/// a render plus its 30 s `image_inflight` retention and the cross-id copies
+/// it spawns, so a render that was in flight during the change cannot leave
+/// the old art cached.
+pub const REPURGE_AFTER_CHANGE: Duration = Duration::from_secs(60);
+/// Re-purge this long after an override's image failed to load (the
+/// automatic art got cached meanwhile); once per override version.
+pub const REPURGE_AFTER_SOURCE_FAILURE: Duration = Duration::from_secs(600);
+/// Most delayed re-purges waiting at once; beyond this, new ones are dropped
+/// (logged) so a storm of saves or failures cannot queue unbounded work.
+pub const MAX_PENDING_REPURGES: usize = 256;
+/// Most remembered source failures (cleared when full).
+pub const MAX_SOURCE_FAILURES: usize = 1024;
+
+/// Identity of a key in the re-purge bookkeeping.
+pub fn job_key(key: &OverrideKey) -> String {
+    format!(
+        "{}/{}/{}/{}/{}/{}",
+        key.media_type,
+        key.tmdb_id,
+        key.kind.label(),
+        key.season,
+        key.episode,
+        key.lang
+    )
+}
+
+/// When the delayed re-purge of `key` will run, if one is pending.
+pub fn pending_repurge(state: &AppState, key: &OverrideKey) -> Option<tokio::time::Instant> {
+    super::store(state).repurges.get(&job_key(key)).map(|d| *d)
+}
+
+/// Number of pending delayed re-purges.
+pub fn pending_repurges(state: &AppState) -> usize {
+    super::store(state).repurges.len()
+}
+
+/// Purge `key` again after `delay`. One job per key: scheduling a key that
+/// is already pending only moves its run time later (never earlier). Returns
+/// false when the job was dropped because [`MAX_PENDING_REPURGES`] are
+/// pending.
+pub fn schedule_repurge(state: &AppState, key: &OverrideKey, delay: Duration) -> bool {
+    let jobs = &super::store(state).repurges;
+    let k = job_key(key);
+    let due = tokio::time::Instant::now() + delay;
+    if let Some(mut existing) = jobs.get_mut(&k) {
+        if *existing < due {
+            *existing = due;
+        }
+        return true;
+    }
+    if jobs.len() >= MAX_PENDING_REPURGES {
+        tracing::warn!(key = %k, "override: too many pending re-purges; skipping this one");
+        return false;
+    }
+    if jobs.insert(k.clone(), due).is_some() {
+        // Raced with another scheduler: that job runs (at least as late).
+        return true;
+    }
+    let st = state.clone();
+    let key = key.clone();
+    tokio::spawn(async move {
+        let job = {
+            let (st, key, k) = (st.clone(), key.clone(), k.clone());
+            tokio::spawn(async move { run_repurge(&st, &key, &k).await })
+        };
+        if job.await.is_err() {
+            // A panic must not leave the key blocked.
+            super::store(&st).repurges.remove(&k);
+        }
+    });
+    true
+}
+
+async fn run_repurge(state: &AppState, key: &OverrideKey, k: &str) {
+    loop {
+        let Some(due) = pending_repurge(state, key) else {
+            return;
+        };
+        if tokio::time::Instant::now() < due {
+            tokio::time::sleep_until(due).await;
+            continue;
+        }
+        let started = tokio::time::Instant::now();
+        let out = purge_for(state, key).await;
+        tracing::info!(key = %k, ids = ?out.ids, files_deleted = out.files_deleted, "override: delayed re-purge");
+        // Done, unless someone scheduled it again while the purge ran.
+        if super::store(state)
+            .repurges
+            .remove_if(k, |_, d| *d <= started)
+            .is_some()
+        {
+            return;
+        }
+    }
+}
+
+/// An override's image could not be fetched or decoded, so the automatic
+/// art was rendered (and cached) instead: purge again later, once per
+/// override version (`updated_at`), so a lasting failure is not retried
+/// forever.
+pub fn note_source_failure(state: &AppState, key: &OverrideKey, updated_at: i64) {
+    let failures = &super::store(state).source_failures;
+    let tag = format!("{}#{updated_at}", job_key(key));
+    if failures.contains_key(&tag) {
+        return;
+    }
+    if failures.len() >= MAX_SOURCE_FAILURES {
+        failures.clear();
+    }
+    if failures.insert(tag, ()).is_none() {
+        schedule_repurge(state, key, REPURGE_AFTER_SOURCE_FAILURE);
+    }
+}
+
+/// Whether a failure of this override version was already noted.
+pub fn source_failure_noted(state: &AppState, key: &OverrideKey, updated_at: i64) -> bool {
+    super::store(state)
+        .source_failures
+        .contains_key(&format!("{}#{updated_at}", job_key(key)))
+}
+
+/// Every `(id_type, id_value)` renders of `key`'s title + kind may be cached
+/// under. Renders are cached per REQUESTED id (plus cross-id copies), so
+/// this collects:
+/// - the canonical TMDB id (`movie-{id}` / `series-{id}`; for stills
+///   `episode-{id}-S{s}E{e}`);
+/// - the title's imdb and tvdb ids from `id::resolve` of the canonical id
+///   (through `id_cache`; skipped with a warning when TMDB cannot be reached),
+///   in their `episode-{id}-S{s}E{e}` form for stills;
+/// - every id in `id_cache` that resolves to this title (and, for stills, this
+///   episode): the ids it was requested under recently, e.g. an episode's own
+///   imdb id or a lowercase `s1e2` form;
+/// - for posters, logos and backdrops of a show: every `episode-{id}-…` id
+///   with a cached render of this kind in `image_meta` (an episode id
+///   requested on a show route is uplifted to the show and cached under the
+///   episode id).
+pub async fn alias_targets(state: &AppState, key: &OverrideKey) -> Vec<(String, String)> {
+    let mut out: Vec<(String, String)> = Vec::new();
+    let mut push = |t: &str, v: String| {
+        if !v.is_empty() && !out.iter().any(|(a, b)| a == t && *b == v) {
+            out.push((t.to_owned(), v));
+        }
+    };
+    let episode = key.kind == ImageType::Episode;
+    let ep_suffix = format!("-S{}E{}", key.season, key.episode);
+    let canonical = if key.media_type == "movie" {
+        format!("movie-{}", key.tmdb_id)
+    } else {
+        format!("series-{}", key.tmdb_id)
+    };
+
+    let (imdb_id, tvdb_id) = match id::resolve(
+        IdType::Tmdb,
+        &canonical,
+        &state.tmdb,
+        &state.id_cache,
+    )
+    .await
+    {
+        Ok(r) => (r.imdb_id.filter(|s| !s.is_empty()), r.tvdb_id),
+        Err(e) => {
+            tracing::warn!(error = %e, id = %canonical, "override: resolving the title's imdb/tvdb ids failed; purging the ids known locally");
+            (None, None)
+        }
+    };
+    let tmdb_base = key.tmdb_id.to_string();
+    let tvdb_base = tvdb_id.map(|v| v.to_string());
+    if episode {
+        push("tmdb", format!("episode-{tmdb_base}{ep_suffix}"));
+        if let Some(imdb) = &imdb_id {
+            push("imdb", format!("episode-{imdb}{ep_suffix}"));
+        }
+        if let Some(tvdb) = &tvdb_base {
+            push("tvdb", format!("episode-{tvdb}{ep_suffix}"));
+        }
+    } else {
+        push("tmdb", canonical.clone());
+        if let Some(imdb) = &imdb_id {
+            push("imdb", imdb.clone());
+        }
+        if let Some(tvdb) = &tvdb_base {
+            push("tvdb", tvdb.clone());
+        }
+    }
+
+    // Ids requested recently that resolve to this title.
+    let want = Some((key.media_type, key.tmdb_id, key.season, key.episode));
+    for (k, resolved) in state.id_cache.iter() {
+        if apply::title_of(&resolved, key.kind) != want {
+            continue;
+        }
+        if let Some((t, v)) = k.split_once('/') {
+            push(t, v.to_owned());
+        }
+    }
+
+    // Show art cached under episode ids.
+    if !episode && key.media_type == "tv" {
+        let bases = [
+            ("tmdb", Some(tmdb_base)),
+            ("imdb", imdb_id),
+            ("tvdb", tvdb_base),
+        ];
+        for (t, base) in bases {
+            let Some(base) = base else { continue };
+            for v in episode_ids_with_renders(state, key.kind, t, &base).await {
+                push(t, v);
+            }
+        }
+    }
+    out
+}
+
+/// Distinct `episode-{base}-…` id values of `id_type` with a cached render of
+/// `kind` (from `image_meta`).
+async fn episode_ids_with_renders(
+    state: &AppState,
+    kind: ImageType,
+    id_type: &str,
+    base: &str,
+) -> Vec<String> {
+    use crate::entity::image_meta;
+    use sea_orm::{ColumnTrait, EntityTrait, QueryFilter};
+
+    let prefix = format!("{id_type}/episode-{base}-");
+    let rows = image_meta::Entity::find()
+        .filter(image_meta::Column::ImageType.eq(kind.db_value()))
+        .filter(image_meta::Column::CacheKey.starts_with(prefix.as_str()))
+        .all(&state.db)
+        .await;
+    let rows = match rows {
+        Ok(rows) => rows,
+        Err(e) => {
+            tracing::warn!(error = %e, "override: reading cached episode-id renders failed");
+            return Vec::new();
+        }
+    };
+    let mut out: Vec<String> = Vec::new();
+    for r in rows {
+        let Some(value) = r.cache_key.strip_prefix(&format!("{id_type}/")) else {
+            continue;
+        };
+        // The id value ends where the variant/settings suffix starts.
+        let id_value = value.split(['_', '@']).next().unwrap_or("");
+        if !id_value.is_empty() && !out.iter().any(|v| v == id_value) {
+            out.push(id_value.to_owned());
+        }
+    }
+    out
+}
diff --git a/api/src/services/overrides/store.rs b/api/src/services/overrides/store.rs
new file mode 100644
index 0000000..e530404
--- /dev/null
+++ b/api/src/services/overrides/store.rs
@@ -0,0 +1,459 @@
+//! The `image_overrides` table and its in-memory mirror.
+//!
+//! The whole table (admin-sized: one row per overridden title + kind) is
+//! loaded into a map on first use and kept in sync by [`OverrideStore::set`]
+//! and [`OverrideStore::clear`], which write the DB first and the map second.
+//! A lookup is a hash probe under a read lock: no DB query, no network, no
+//! error path. While the first load fails (DB unavailable) lookups return
+//! `None` and the next call retries, so a render is never failed by it.
+
+use std::collections::HashMap;
+use std::sync::RwLock;
+use std::sync::atomic::{AtomicI64, AtomicUsize, Ordering};
+
+use dashmap::DashMap;
+
+use sea_orm::{ConnectionTrait, DatabaseBackend, DatabaseConnection, Statement, Value};
+
+use super::{NO_EPISODE, OverrideKey, OverrideSource, TitleOverride, kind_from_name};
+use crate::cache::ImageType;
+use crate::error::AppError;
+use crate::services::lang::lang_base;
+
+/// Seconds between retries of a failed first load.
+pub const LOAD_RETRY_SECS: i64 = 30;
+
+#[derive(Clone, Debug)]
+struct Row {
+    kind: ImageType,
+    season: i32,
+    episode: i32,
+    lang: String,
+    ov: TitleOverride,
+}
+
+type Map = HashMap<(&'static str, u64), Vec<Row>>;
+
+pub struct OverrideStore {
+    map: tokio::sync::OnceCell<RwLock<Map>>,
+    /// Serialises writers so the DB and the map change in the same order.
+    writes: tokio::sync::Mutex<()>,
+    /// Rows in the map, and rows with `no_badges` (cheap pre-checks).
+    rows: AtomicUsize,
+    no_badges_rows: AtomicUsize,
+    /// Unix seconds of the last failed first load (retries wait 30 s).
+    load_failed_at: AtomicI64,
+    /// Delayed re-purges waiting to run: job key → when (see `purge`).
+    pub(crate) repurges: DashMap<String, tokio::time::Instant>,
+    /// `(key, updated_at)` of overrides whose source failed once; each gets
+    /// one delayed re-purge.
+    pub(crate) source_failures: DashMap<String, ()>,
+}
+
+impl Default for OverrideStore {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+fn stmt(sql: &str, values: Vec<Value>) -> Statement {
+    Statement::from_sql_and_values(DatabaseBackend::Sqlite, sql, values)
+}
+
+fn media_type_static(s: &str) -> Option<&'static str> {
+    match s {
+        "movie" => Some("movie"),
+        "tv" => Some("tv"),
+        _ => None,
+    }
+}
+
+impl OverrideStore {
+    pub fn new() -> Self {
+        Self {
+            map: tokio::sync::OnceCell::new(),
+            writes: tokio::sync::Mutex::new(()),
+            rows: AtomicUsize::new(0),
+            no_badges_rows: AtomicUsize::new(0),
+            load_failed_at: AtomicI64::new(0),
+            repurges: DashMap::new(),
+            source_failures: DashMap::new(),
+        }
+    }
+
+    async fn load(&self, db: &DatabaseConnection) -> Result<&RwLock<Map>, AppError> {
+        self.map
+            .get_or_try_init(|| async {
+                let map = load_all(db).await?;
+                self.recount(&map);
+                Ok::<_, AppError>(RwLock::new(map))
+            })
+            .await
+    }
+
+    /// The map, loading it on first use; `None` (logged) while the DB fails.
+    /// While the DB fails, a retry runs at most every [`LOAD_RETRY_SECS`], so a
+    /// broken DB does not cost one failing query and one warning per image.
+    async fn loaded(&self, db: &DatabaseConnection) -> Option<&RwLock<Map>> {
+        if let Some(m) = self.map.get() {
+            return Some(m);
+        }
+        let now = chrono::Utc::now().timestamp();
+        let failed_at = self.load_failed_at.load(Ordering::Relaxed);
+        if failed_at > 0 && now - failed_at < LOAD_RETRY_SECS {
+            return None;
+        }
+        match self.load(db).await {
+            Ok(m) => Some(m),
+            Err(e) => {
+                self.load_failed_at.store(now, Ordering::Relaxed);
+                tracing::warn!(error = %e, "overrides: loading the table failed; serving without overrides (retry in 30 s)");
+                None
+            }
+        }
+    }
+
+    fn recount(&self, map: &Map) {
+        let rows = map.values().map(Vec::len).sum();
+        let nb = map.values().flatten().filter(|r| r.ov.no_badges).count();
+        self.rows.store(rows, Ordering::Relaxed);
+        self.no_badges_rows.store(nb, Ordering::Relaxed);
+    }
+
+    /// Load the table now (e.g. after rows were written behind the store's
+    /// back, in tests). Replaces the map.
+    pub async fn reload(&self, db: &DatabaseConnection) -> Result<(), AppError> {
+        let fresh = load_all(db).await?;
+        let lock = self.load(db).await?;
+        let mut g = lock.write().unwrap_or_else(|p| p.into_inner());
+        *g = fresh;
+        self.recount(&g);
+        Ok(())
+    }
+
+    /// Number of override rows (0 before the first load).
+    pub fn len(&self) -> usize {
+        self.rows.load(Ordering::Relaxed)
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.len() == 0
+    }
+
+    /// True when some row has `no_badges` (loads the table on first use).
+    pub async fn any_no_badges(&self, db: &DatabaseConnection) -> bool {
+        if self.loaded(db).await.is_none() {
+            return false;
+        }
+        self.no_badges_rows.load(Ordering::Relaxed) > 0
+    }
+
+    /// The override a render of this title should use: exact `lang`, then its
+    /// base (`pt-BR` → `pt`), then `""` (any). Language only matters for
+    /// posters and logos; backdrops and stills only have `""` rows.
+    pub async fn lookup(
+        &self,
+        db: &DatabaseConnection,
+        media_type: &'static str,
+        tmdb_id: u64,
+        kind: ImageType,
+        season: i32,
+        episode: i32,
+        lang: &str,
+    ) -> Option<TitleOverride> {
+        self.lookup_keyed(db, media_type, tmdb_id, kind, season, episode, lang)
+            .await
+            .map(|(_, ov)| ov)
+    }
+
+    /// [`Self::lookup`], plus the key of the row that matched (its `lang`).
+    #[allow(clippy::too_many_arguments)]
+    pub async fn lookup_keyed(
+        &self,
+        db: &DatabaseConnection,
+        media_type: &'static str,
+        tmdb_id: u64,
+        kind: ImageType,
+        season: i32,
+        episode: i32,
+        lang: &str,
+    ) -> Option<(OverrideKey, TitleOverride)> {
+        let lock = self.loaded(db).await?;
+        if self.is_empty() {
+            return None;
+        }
+        let g = lock.read().unwrap_or_else(|p| p.into_inner());
+        let rows = g.get(&(media_type, tmdb_id))?;
+        let matching = |l: &str| {
+            rows.iter()
+                .find(|r| {
+                    r.kind == kind && r.season == season && r.episode == episode && r.lang == l
+                })
+                .map(|r| {
+                    let key = OverrideKey {
+                        media_type,
+                        tmdb_id,
+                        kind,
+                        season,
+                        episode,
+                        lang: r.lang.clone(),
+                    };
+                    (key, r.ov.clone())
+                })
+        };
+        if matches!(kind, ImageType::Poster | ImageType::Logo) && !lang.is_empty() {
+            if let Some(ov) = matching(lang) {
+                return Some(ov);
+            }
+            let base = lang_base(lang);
+            if base != lang {
+                if let Some(ov) = matching(base) {
+                    return Some(ov);
+                }
+            }
+        }
+        matching("")
+    }
+
+    /// The row stored under exactly this key (no language fallback).
+    pub async fn get_exact(
+        &self,
+        db: &DatabaseConnection,
+        key: &OverrideKey,
+    ) -> Result<Option<TitleOverride>, AppError> {
+        let lock = self.load(db).await?;
+        let g = lock.read().unwrap_or_else(|p| p.into_inner());
+        Ok(g.get(&(key.media_type, key.tmdb_id)).and_then(|rows| {
+            rows.iter()
+                .find(|r| {
+                    r.kind == key.kind
+                        && r.season == key.season
+                        && r.episode == key.episode
+                        && r.lang == key.lang
+                })
+                .map(|r| r.ov.clone())
+        }))
+    }
+
+    /// Every override of a title, ordered by kind, season, episode, lang.
+    pub async fn list_title(
+        &self,
+        db: &DatabaseConnection,
+        media_type: &'static str,
+        tmdb_id: u64,
+    ) -> Result<Vec<(OverrideKey, TitleOverride)>, AppError> {
+        let lock = self.load(db).await?;
+        let g = lock.read().unwrap_or_else(|p| p.into_inner());
+        let mut out: Vec<(OverrideKey, TitleOverride)> = g
+            .get(&(media_type, tmdb_id))
+            .map(|rows| {
+                rows.iter()
+                    .map(|r| {
+                        (
+                            OverrideKey {
+                                media_type,
+                                tmdb_id,
+                                kind: r.kind,
+                                season: r.season,
+                                episode: r.episode,
+                                lang: r.lang.clone(),
+                            },
+                            r.ov.clone(),
+                        )
+                    })
+                    .collect()
+            })
+            .unwrap_or_default();
+        out.sort_by(|(a, _), (b, _)| {
+            (kind_order(a.kind), a.season, a.episode, &a.lang).cmp(&(
+                kind_order(b.kind),
+                b.season,
+                b.episode,
+                &b.lang,
+            ))
+        });
+        Ok(out)
+    }
+
+    /// Rows that win over `key` for some request languages: for an
+    /// any-language row every language row of the same kind/episode, for a
+    /// base-language row (`pt`) its regional rows (`pt-BR`).
+    pub async fn shadowing(
+        &self,
+        db: &DatabaseConnection,
+        key: &OverrideKey,
+    ) -> Result<Vec<(OverrideKey, TitleOverride)>, AppError> {
+        Ok(self
+            .list_title(db, key.media_type, key.tmdb_id)
+            .await?
+            .into_iter()
+            .filter(|(k, _)| {
+                k.kind == key.kind
+                    && k.season == key.season
+                    && k.episode == key.episode
+                    && k.lang != key.lang
+                    && (key.lang.is_empty()
+                        || (k.lang.len() > key.lang.len()
+                            && k.lang.starts_with(&format!("{}-", key.lang))))
+            })
+            .collect())
+    }
+
+    /// Insert or replace an override (DB first, then the map).
+    pub async fn set(
+        &self,
+        db: &DatabaseConnection,
+        key: &OverrideKey,
+        ov: &TitleOverride,
+    ) -> Result<(), AppError> {
+        let _w = self.writes.lock().await;
+        let lock = self.load(db).await?;
+        db.execute(stmt(
+            "INSERT INTO image_overrides
+                (media_type, tmdb_id, kind, season, episode, lang, source, value, fanart_id, no_badges, updated_at)
+             VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+             ON CONFLICT(media_type, tmdb_id, kind, season, episode, lang) DO UPDATE SET
+                source = excluded.source,
+                value = excluded.value,
+                fanart_id = excluded.fanart_id,
+                no_badges = excluded.no_badges,
+                updated_at = excluded.updated_at",
+            vec![
+                key.media_type.into(),
+                (key.tmdb_id as i64).into(),
+                key.kind.label().into(),
+                key.season.into(),
+                key.episode.into(),
+                key.lang.clone().into(),
+                ov.source.name().into(),
+                ov.source.value().to_owned().into(),
+                ov.source.fanart_id().map(str::to_owned).into(),
+                i64::from(ov.no_badges).into(),
+                ov.updated_at.into(),
+            ],
+        ))
+        .await?;
+        let mut g = lock.write().unwrap_or_else(|p| p.into_inner());
+        let rows = g.entry((key.media_type, key.tmdb_id)).or_default();
+        let row = Row {
+            kind: key.kind,
+            season: key.season,
+            episode: key.episode,
+            lang: key.lang.clone(),
+            ov: ov.clone(),
+        };
+        match rows.iter_mut().find(|r| {
+            r.kind == key.kind
+                && r.season == key.season
+                && r.episode == key.episode
+                && r.lang == key.lang
+        }) {
+            Some(existing) => *existing = row,
+            None => rows.push(row),
+        }
+        self.recount(&g);
+        Ok(())
+    }
+
+    /// Delete an override; `false` when there was none.
+    pub async fn clear(
+        &self,
+        db: &DatabaseConnection,
+        key: &OverrideKey,
+    ) -> Result<bool, AppError> {
+        let _w = self.writes.lock().await;
+        let lock = self.load(db).await?;
+        let res = db
+            .execute(stmt(
+                "DELETE FROM image_overrides
+                 WHERE media_type = ? AND tmdb_id = ? AND kind = ? AND season = ? AND episode = ? AND lang = ?",
+                vec![
+                    key.media_type.into(),
+                    (key.tmdb_id as i64).into(),
+                    key.kind.label().into(),
+                    key.season.into(),
+                    key.episode.into(),
+                    key.lang.clone().into(),
+                ],
+            ))
+            .await?;
+        let mut g = lock.write().unwrap_or_else(|p| p.into_inner());
+        let mut removed = false;
+        if let Some(rows) = g.get_mut(&(key.media_type, key.tmdb_id)) {
+            let before = rows.len();
+            rows.retain(|r| {
+                !(r.kind == key.kind
+                    && r.season == key.season
+                    && r.episode == key.episode
+                    && r.lang == key.lang)
+            });
+            removed = rows.len() != before;
+            if rows.is_empty() {
+                g.remove(&(key.media_type, key.tmdb_id));
+            }
+        }
+        self.recount(&g);
+        Ok(removed || res.rows_affected() > 0)
+    }
+}
+
+fn kind_order(k: ImageType) -> u8 {
+    match k {
+        ImageType::Poster => 0,
+        ImageType::Logo => 1,
+        ImageType::Backdrop => 2,
+        ImageType::Episode => 3,
+    }
+}
+
+async fn load_all(db: &DatabaseConnection) -> Result<Map, AppError> {
+    let rows = db
+        .query_all(stmt(
+            "SELECT media_type, tmdb_id, kind, season, episode, lang, source, value, fanart_id, no_badges, updated_at
+             FROM image_overrides",
+            vec![],
+        ))
+        .await?;
+    let mut map: Map = HashMap::new();
+    for r in &rows {
+        let media_type: String = r.try_get("", "media_type")?;
+        let tmdb_id: i64 = r.try_get("", "tmdb_id")?;
+        let kind: String = r.try_get("", "kind")?;
+        let season: i64 = r.try_get("", "season")?;
+        let episode: i64 = r.try_get("", "episode")?;
+        let lang: String = r.try_get("", "lang")?;
+        let source: String = r.try_get("", "source")?;
+        let value: String = r.try_get("", "value")?;
+        let fanart_id: Option<String> = r.try_get("", "fanart_id")?;
+        let no_badges: i64 = r.try_get("", "no_badges")?;
+        let updated_at: i64 = r.try_get("", "updated_at")?;
+        let (Some(mt), Some(kind), Ok(source)) = (
+            media_type_static(&media_type),
+            kind_from_name(&kind),
+            OverrideSource::from_parts(&source, &value, fanart_id.as_deref()),
+        ) else {
+            tracing::warn!(media_type = %media_type, tmdb_id, kind = %kind, source = %source, "overrides: skipping an invalid row");
+            continue;
+        };
+        let (Ok(season), Ok(episode)) = (i32::try_from(season), i32::try_from(episode)) else {
+            continue;
+        };
+        let (season, episode) = if kind == ImageType::Episode {
+            (season, episode)
+        } else {
+            (NO_EPISODE, NO_EPISODE)
+        };
+        map.entry((mt, tmdb_id as u64)).or_default().push(Row {
+            kind,
+            season,
+            episode,
+            lang,
+            ov: TitleOverride {
+                source,
+                no_badges: no_badges != 0,
+                updated_at,
+            },
+        });
+    }
+    Ok(map)
+}
